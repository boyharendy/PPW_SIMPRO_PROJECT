# ============================================================
# SIMPRO - Template Environment FRONTEND (Next.js)
# ============================================================
# Salin file ini menjadi: frontend/.env.local
# File ini KHUSUS untuk aplikasi browser/klien Next.js.
# Variabel yang dapat dibaca oleh browser WAJIB diawali NEXT_PUBLIC_.
# ============================================================

# 1. Alamat Backend Golang REST API
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_API_TIMEOUT=15000
# Aktifkan dengan true untuk masuk otomatis sebagai Kaprodi saat menjalankan Next.js secara lokal.
NEXT_PUBLIC_DEV_AUTO_LOGIN=false

# 2. Supabase Client (Aman dibaca browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL internal API Go untuk relay aduan anonim dari server Next.js.
SIMPRO_BACKEND_URL=http://localhost:8080/api/v1
