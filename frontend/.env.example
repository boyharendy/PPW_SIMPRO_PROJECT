# ============================================================
# SIMPRO - Environment Configuration (Next.js Frontend)
# ============================================================

# URL Backend Golang (REST API)
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# Environment (development, staging, production)
NEXT_PUBLIC_APP_ENV=development

# Request Timeout (milliseconds)
NEXT_PUBLIC_API_TIMEOUT=15000

# ============================================================
# Supabase Configuration
# ============================================================
# Ambil dari: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service Role Secret (Hanya untuk server/backend)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Supabase Direct PostgreSQL Database URI (Untuk Backend Golang / Migrasi)
# Ambil dari: Supabase Dashboard -> Project Settings -> Database -> Connection string -> URI
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
