# Mode lokal memakai fixture dan penyimpanan dalam memori.
SERVER_ENV=development
SERVER_HOST=127.0.0.1
SERVER_PORT=8080
API_PREFIX=/api/v1
FRONTEND_URL=http://localhost:3000

# Opsional jika executable Go belum tersedia di PATH.
# SIMPRO_GO_EXE=C:/Program Files/Go/bin/go.exe

# Staging dan produksi memakai layanan berikut. Isi melalui secret manager.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
REDIS_URL=
PERMIT_SECRET=
TICKET_PEPPER=

# Kunci JWT lokal kosong menghasilkan kunci acak untuk proses ini.
JWT_SECRET=
JWT_EXPIRATION_HOURS=24
JWT_REFRESH_EXPIRATION_DAYS=7
